          "options": {
            "html": "<style>\n  html, body { margin: 0; height: 100%; overflow: hidden; }\n  .ground { position: absolute; bottom: 6vh; left: 0; right: 0; height: 2px; background: #2a3140; }\n  #pos { position: absolute; left: 0; bottom: 2.9vh; width: 88vh; will-change: transform; cursor: pointer; -webkit-tap-highlight-color: transparent; }\n  .roller { transform-origin: 50% 60%; }\n  #flip svg { width: 100%; display: block; overflow: visible; }\n\n  /* ================= ขา ================= */\n  .leg { transform-box: fill-box; transform-origin: 50% 0; transition: transform .3s, opacity .3s; }\n  #pos.walk  { --dur: .42s; --amp: 24deg; }\n  #pos.run   { --dur: .15s; --amp: 40deg; }\n  #pos.dance { --dur: .3s;  --amp: 14deg; }\n  #pos.walk .leg, #pos.run .leg, #pos.dance .leg { animation: step var(--dur) ease-in-out infinite alternate; }\n  #pos.walk .leg.b, #pos.run .leg.b, #pos.dance .leg.b { animation-delay: calc(var(--dur) * -1); }\n  @keyframes step { from { transform: rotate(var(--amp)); } to { transform: rotate(calc(var(--amp) * -1)); } }\n  #pos.jump .leg { animation: none !important; }\n  #pos.jump .leg.front { transform: rotate(-40deg); }\n  #pos.jump .leg.rear  { transform: rotate(40deg); }\n  #pos.sit .leg.rear   { transform: scaleY(.35); }\n  #pos.sleep .leg      { opacity: 0; }\n  #pos.roll .leg       { transform: scaleY(.4); }\n  #pos.crouch .leg     { transform: translateY(10px) scaleY(.69); }\n  #pos.stretch .leg.front { transform: rotate(-60deg); }\n  #pos.scared .leg     { transform: scaleY(1.15); }\n  #pos.groom .leg.front.b { animation: lick .35s ease-in-out infinite alternate; }\n  @keyframes lick { from { transform: rotate(-118deg); } to { transform: rotate(-138deg); } }\n  #pos.bfly .leg.front.b { animation: swat 1.3s ease-in-out infinite; }\n  @keyframes swat { 0%, 30%, 100% { transform: rotate(0); } 50%, 60% { transform: rotate(-155deg); } }\n\n  /* ================= ตัว ================= */\n  #pos.walk .bob, #pos.run .bob { animation: bob calc(var(--dur) / 2) ease-in-out infinite alternate; }\n  @keyframes bob { from { transform: translateY(0); } to { transform: translateY(-3px); } }\n  .bodyg { transform-origin: 45px 102px; transition: transform .45s; }\n  #pos.sit .bodyg     { transform: translateY(8px) rotate(-6deg); }\n  #pos.sleep .bodyg   { transform: translateY(14px) scaleY(.85); }\n  #pos.stretch .bodyg { transform: rotate(9deg); }\n  #pos.scared .bodyg  { transform: translateY(-6px) scaleY(1.15); }\n  #pos.crouch .bodyg  { transform-origin: 140px 100px; animation: wiggle .15s ease-in-out infinite alternate; }\n  @keyframes wiggle { from { transform: translateY(10px) rotate(-3deg); } to { transform: translateY(10px) rotate(3deg); } }\n  #pos.dance .bodyg   { animation: groove .3s ease-in-out infinite alternate; }\n  @keyframes groove { from { transform: translateY(0) rotate(-4deg); } to { transform: translateY(-5px) rotate(4deg); } }\n  #pos.roll .roller   { animation: roll .9s linear infinite; }\n  @keyframes roll { to { transform: rotate(360deg); } }\n\n  /* ================= หัว ================= */\n  .head { transform-origin: 145px 72px; transition: transform .45s; }\n  #pos.sleep .head { transform: translateY(6px) rotate(12deg); }\n  #pos.groom .head { transform: rotate(14deg); }\n  #pos.bfly .head  { transform: rotate(-20deg); }\n  #pos.look .head  { animation: tilt 1.3s ease-in-out infinite alternate; }\n  #pos.dance .head { animation: tilt .6s ease-in-out infinite alternate; }\n  @keyframes tilt { from { transform: rotate(-12deg); } to { transform: rotate(12deg); } }\n  #pos.eat .head   { animation: chomp .25s ease-in-out infinite alternate; }\n  @keyframes chomp { from { transform: translateY(4px) rotate(22deg); } to { transform: translateY(9px) rotate(28deg); } }\n\n  /* ================= หาง ================= */\n  .tail { transform-box: fill-box; transform-origin: 100% 100%; animation: wag 1.1s ease-in-out infinite alternate; }\n  #pos.run .tail, #pos.dance .tail { animation-duration: .3s; }\n  #pos.scared .tail { animation-duration: .08s; }\n  #pos.sleep .tail  { animation-duration: 3.5s; }\n  @keyframes wag { from { transform: rotate(-12deg); } to { transform: rotate(14deg); } }\n\n  /* ================= ตา / ปาก ================= */\n  .eo { transform-box: fill-box; transform-origin: center; transition: transform .2s; }\n  .eo ellipse { transform-box: fill-box; transform-origin: center; animation: blink 4s infinite; }\n  @keyframes blink { 0%, 93%, 100% { transform: scaleY(1); } 96% { transform: scaleY(.1); } }\n  .ec, .eh, .mouthO { opacity: 0; }\n  .mouthO { transform-box: fill-box; transform-origin: center; }\n  #pos.sleep .eo, #pos.stretch .eo, #pos.groom .eo, #pos.happy .eo, #pos.dance .eo { opacity: 0; }\n  #pos.sleep .ec, #pos.stretch .ec, #pos.groom .ec { opacity: 1; }\n  #pos.happy .eh, #pos.dance .eh { opacity: 1; }\n  #pos.scared .eo { transform: scale(1.5); }\n  #pos.meow .mouthO, #pos.scared .mouthO { opacity: 1; }\n  #pos.stretch .mouthO { opacity: 1; transform: scale(1.7); }\n\n  /* ================= ของประกอบ ================= */\n  .prop { position: absolute; pointer-events: none; opacity: 0; transition: opacity .35s; }\n  #pos.sleep .zzz, #pos.dance .notes, #pos.bfly .butterfly, #pos.yarn .ball, #pos.eat .fish { opacity: 1; }\n  .zzz, .notes { top: -8%; font: 700 8vh sans-serif; }\n  .zzz { color: #93c5fd; } .notes { color: #c4b5fd; }\n  .zzz span, .notes span { position: absolute; opacity: 0; animation: floatUp 2.4s linear infinite; }\n  .zzz span:nth-child(2), .notes span:nth-child(2) { animation-delay: .8s; }\n  .zzz span:nth-child(3), .notes span:nth-child(3) { animation-delay: 1.6s; }\n  @keyframes floatUp { 0% { transform: translate(0,0) scale(.6); opacity: 0; } 20% { opacity: 1; }\n                       100% { transform: translate(5vh,-16vh) scale(1.2); opacity: 0; } }\n  .bubble { top: -30%; padding: .5vh 2.5vh; background: #fff; color: #111; border-radius: 3vh;\n            font: 700 7vh sans-serif; white-space: nowrap; transform: scale(.5); transition: .2s; }\n  #pos.talk .bubble { opacity: 1; transform: scale(1); }\n  .butterfly { top: -38%; font-size: 10vh; animation: flutter 2.2s ease-in-out infinite; }\n  .butterfly span { display: inline-block; animation: flap .18s ease-in-out infinite alternate; }\n  @keyframes flutter { 0%,100% { transform: translate(0,0); } 25% { transform: translate(7vh,-5vh); }\n                       50% { transform: translate(2vh,4vh); } 75% { transform: translate(-6vh,-3vh); } }\n  @keyframes flap { from { transform: scaleX(1); } to { transform: scaleX(.4); } }\n  .ball { bottom: 4%; font-size: 13vh; line-height: 1; }\n  .ball span { display: inline-block; animation: spin .8s linear infinite; }\n  @keyframes spin { to { transform: rotate(360deg); } }\n  .fish { bottom: 4%; font-size: 12vh; line-height: 1; }\n  .heart { position: absolute; top: 0; font-size: 8vh; pointer-events: none; animation: heart 1s ease-out forwards; }\n  @keyframes heart { from { transform: translate(0,0) scale(.5); opacity: 1; }\n                     to { transform: translate(var(--dx), -20vh) scale(1.2); opacity: 0; } }\n</style>\n\n<div class=\"ground\"></div>\n<div id=\"pos\" class=\"walk\">\n  <div class=\"prop zzz\"><span>z</span><span>z</span><span>Z</span></div>\n  <div class=\"prop notes\"><span>♪</span><span>♫</span><span>♪</span></div>\n  <div class=\"prop bubble\">เมี้ยว~</div>\n  <div class=\"prop butterfly\"><span>🦋</span></div>\n  <div class=\"prop ball\"><span>🧶</span></div>\n  <div class=\"prop fish\">🐟</div>\n  <div id=\"flip\"><div class=\"roller\">\n    <svg viewBox=\"0 0 200 125\">\n      <rect class=\"leg rear b\"  x=\"68\"  y=\"86\" width=\"12\" height=\"32\" rx=\"6\" fill=\"#c2700a\"/>\n      <rect class=\"leg front a\" x=\"128\" y=\"86\" width=\"12\" height=\"32\" rx=\"6\" fill=\"#c2700a\"/>\n      <g class=\"bob\"><g class=\"bodyg\">\n        <path class=\"tail\" d=\"M44 72 Q14 64 18 34 Q20 20 30 24\" fill=\"none\" stroke=\"#f59e0b\" stroke-width=\"10\" stroke-linecap=\"round\"/>\n        <ellipse cx=\"95\" cy=\"74\" rx=\"56\" ry=\"28\" fill=\"#f59e0b\"/>\n        <path d=\"M80 48 q4 14 0 26 M98 46 q4 14 0 28 M116 48 q4 14 0 26\" stroke=\"#d97706\" stroke-width=\"5\" fill=\"none\" stroke-linecap=\"round\"/>\n        <g class=\"head\">\n          <polygon points=\"136,40 140,14 156,32\" fill=\"#f59e0b\"/>\n          <polygon points=\"158,31 172,13 178,40\" fill=\"#f59e0b\"/>\n          <polygon points=\"140,34 142,22 150,31\" fill=\"#fda4af\"/>\n          <polygon points=\"163,30 171,21 173,36\" fill=\"#fda4af\"/>\n          <circle cx=\"157\" cy=\"55\" r=\"26\" fill=\"#f59e0b\"/>\n          <g class=\"eo\"><ellipse cx=\"152\" cy=\"52\" rx=\"3\" ry=\"4.5\" fill=\"#1f2937\"/><ellipse cx=\"167\" cy=\"52\" rx=\"3\" ry=\"4.5\" fill=\"#1f2937\"/></g>\n          <path class=\"ec\" d=\"M148 53 q4 3 8 0 M163 53 q4 3 8 0\" stroke=\"#1f2937\" stroke-width=\"2\" fill=\"none\" stroke-linecap=\"round\"/>\n          <path class=\"eh\" d=\"M148 54 q4 -6 8 0 M163 54 q4 -6 8 0\" stroke=\"#1f2937\" stroke-width=\"2\" fill=\"none\" stroke-linecap=\"round\"/>\n          <circle cx=\"146\" cy=\"62\" r=\"3.5\" fill=\"#fb7185\" opacity=\".45\"/>\n          <path d=\"M157 61 l4 0 l-2 3 z\" fill=\"#fb7185\"/>\n          <path d=\"M159 64 q-3 5 -7 3 M159 64 q3 5 7 3\" stroke=\"#1f2937\" stroke-width=\"1.5\" fill=\"none\" stroke-linecap=\"round\"/>\n          <ellipse class=\"mouthO\" cx=\"159\" cy=\"68\" rx=\"3\" ry=\"3.5\" fill=\"#7f1d1d\"/>\n          <path d=\"M170 62 l18 -3 M170 66 l18 2 M146 62 l-16 -3 M146 66 l-16 2\" stroke=\"#fff7ed\" stroke-width=\"1.2\" stroke-linecap=\"round\"/>\n        </g>\n      </g></g>\n      <rect class=\"leg rear a\"  x=\"56\"  y=\"86\" width=\"12\" height=\"32\" rx=\"6\" fill=\"#f59e0b\"/>\n      <rect class=\"leg front b\" x=\"116\" y=\"86\" width=\"12\" height=\"32\" rx=\"6\" fill=\"#f59e0b\"/>\n    </svg>\n  </div></div>\n</div>\n\n<script>\n  const pos = document.getElementById('pos'), flip = document.getElementById('flip');\n  const $ = (s) => pos.querySelector(s);\n  const bubble = $('.bubble'), headProps = [$('.zzz'), $('.notes'), $('.butterfly')];\n  const frontProps = [$('.ball'), $('.fish')], ballSpin = $('.ball span');\n\n  // w = โอกาสสุ่ม, d = วินาที, v = ความเร็ว (สัดส่วนจอ/วินาที), say = บับเบิล, next = ท่าถัดไปบังคับ\n  const ST = {\n    walk:    { w: 3,   d: [1.5, 3],   v: .10, cls: 'walk' },\n    run:     { w: 1,   d: [1, 2],     v: .38, cls: 'run' },\n    roll:    { w: 1,   d: [1.8, 1.8], v: .18, cls: 'roll' },\n    yarn:    { w: 1,   d: [2.5, 4],   v: .12, cls: 'walk yarn' },\n    jump:    { w: 1.5, d: [.75, .75], v: .20, cls: 'walk jump' },\n    sit:     { w: .6,  d: [2, 3],             cls: 'sit' },\n    look:    { w: 1.2, d: [2, 3],             cls: 'sit look' },\n    meow:    { w: 1.5, d: [1.5, 2],           cls: 'sit meow talk', say: 'เมี้ยว~' },\n    sleep:   { w: .7,  d: [5, 8],             cls: 'sleep', next: 'stretch' },\n    stretch: { w: .5,  d: [2, 2.5],           cls: 'stretch' },\n    groom:   { w: 1.3, d: [2.5, 4],           cls: 'sit groom' },\n    pounce:  { w: 1.5, d: [1.9, 1.9],         cls: 'crouch' },\n    spin:    { w: 1.2, d: [1.5, 2],           cls: 'walk' },\n    bfly:    { w: 1.3, d: [3, 4],             cls: 'sit bfly' },\n    eat:     { w: 1.2, d: [2.5, 3.5],         cls: 'sit eat talk', say: 'ง่ำ ง่ำ' },\n    dance:   { w: 1.3, d: [2.5, 4],           cls: 'dance' },\n    scared:  { w: .8,  d: [1, 1],             cls: 'scared talk', say: '!!', next: 'run' },\n  };\n  const MOVE = ['walk', 'run', 'roll', 'yarn'];\n  const ACTION = Object.keys(ST).filter(k => !MOVE.includes(k));\n\n  const rnd = (a, b) => a + Math.random() * (b - a);\n  const arc = (p) => (p >= 1 || p < 0) ? 0 : Math.sin(Math.PI * p);\n  let state = 'walk', start = 0, until = 0, x = 0, dir = 1, last = performance.now(), leapt = false, lastFlip = 0;\n\n  function weighted(keys) {\n    let r = Math.random() * keys.reduce((s, k) => s + ST[k].w, 0);\n    for (const k of keys) if ((r -= ST[k].w) <= 0) return k;\n    return keys[0];\n  }\n  function pick() {\n    if (ST[state].next) return ST[state].next;\n    // เดินเสร็จ → ต้องทำแอ็กชันเสมอ / แอ็กชันเสร็จ → 65% ทำแอ็กชันต่อ, 35% เดินต่อ\n    const pool = MOVE.includes(state) || Math.random() < .65 ? ACTION : MOVE;\n    return weighted(pool.filter(k => k !== state));\n  }\n  function setState(s, now = performance.now()) {\n    state = s; start = now; leapt = false;\n    until = now + rnd(...ST[s].d) * 1000;\n    pos.className = ST[s].cls;\n    if (ST[s].say) bubble.textContent = ST[s].say;\n    if (MOVE.includes(s) && Math.random() < .35) dir *= -1;\n  }\n\n  // แตะแมว: ถ้าหลับอยู่ = สะดุ้ง, ถ้าตื่น = หัวใจ + กระโดด\n  pos.addEventListener('pointerdown', () => {\n    if (state === 'sleep') return setState('scared');\n    setState('jump');\n    pos.classList.add('happy');\n    setTimeout(() => pos.classList.remove('happy'), 1200);\n    for (let i = 0; i < 5; i++) {\n      const h = document.createElement('span');\n      h.className = 'heart'; h.textContent = '❤';\n      h.style.left = (dir > 0 ? 62 : 8) + rnd(-8, 8) + '%';\n      h.style.color = ['#fb7185', '#f43f5e', '#fda4af'][i % 3];\n      h.style.setProperty('--dx', rnd(-7, 7) + 'vh');\n      h.style.animationDelay = i * .1 + 's';\n      pos.appendChild(h);\n      setTimeout(() => h.remove(), 1700);\n    }\n  });\n\n  function tick(now) {\n    const dt = Math.min(.05, (now - last) / 1000); last = now;\n    if (now > until) setState(pick(), now);\n    const t = (now - start) / 1000, H = innerHeight;\n    let v = ST[state].v || 0, y = 0;\n\n    if (state === 'jump')   y = arc(t / .75) * H * .2;\n    if (state === 'scared') y = arc(t / .45) * H * .12;\n    if (state === 'spin' && now - lastFlip > 160) { dir *= -1; lastFlip = now; }\n    if (state === 'pounce' && t > 1.2) {             // หมอบ 1.2 วิ แล้วพุ่ง\n      if (!leapt) { pos.className = 'walk jump'; leapt = true; }\n      v = .55; y = arc((t - 1.2) / .7) * H * .24;\n    }\n\n    const W = innerWidth, w = pos.offsetWidth;\n    x += dir * W * v * dt;\n    if (x > W - w) { x = W - w; dir = -1; }\n    if (x < 0)     { x = 0;     dir = 1; }\n\n    pos.style.transform = `translate(${x}px, ${-y}px)`;\n    flip.style.transform = `scaleX(${dir})`;\n    headProps.forEach(p => p.style.left = (dir > 0 ? 66 : 4) + '%');\n    frontProps.forEach(p => p.style.left = (dir > 0 ? 90 : -10) + '%');\n    bubble.style.left = (dir > 0 ? 52 : -6) + '%';\n    ballSpin.style.animationDirection = dir > 0 ? 'normal' : 'reverse';\n    requestAnimationFrame(tick);\n  }\n  setState('walk');\n  requestAnimationFrame(tick);\n</script>",
            "transparent": false
          }
        }
      ]
    },
